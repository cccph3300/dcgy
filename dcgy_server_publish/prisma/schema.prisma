generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model AiChatMessage {
  id        Int      @id @default(autoincrement())
  staffId   Int      @map("staff_id")
  role      AiChatRole
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, id], map: "ai_chat_messages_staff_id_id_idx")
  @@index([staffId, createdAt], map: "ai_chat_messages_staff_id_created_at_idx")
  @@map("ai_chat_messages")
}

model StaffUser {
  id                Int                @id @default(autoincrement())
  username          String             @unique @db.VarChar(40)
  passwordHash      String             @map("password_hash") @db.VarChar(128)
  name              String             @db.VarChar(40)
  enabled           Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at")
  orders            Order[]
  printRecords      PrintRecord[]
  customerPaymentRecords CustomerPaymentRecord[]
  supplierPaymentRecords SupplierPaymentRecord[]
  supermarketPaymentRecords SupermarketPaymentRecord[]
  retailOrders      RetailOrder[]
  retailProducts    RetailProduct[]
  sessions          StaffSession[]
  supermarketOrders SupermarketOrder[]
  supplierEntries    SupplierEntry[]
  aiChatMessages AiChatMessage[]
  @@map("staff_users")
}

model StaffSession {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  staffId   Int       @map("staff_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  staff     StaffUser @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@map("staff_sessions")
}

model Goods {
  id                Int                    @id @default(autoincrement())
  name              String                 @db.VarChar(50)
  unitType          UnitType               @map("unit_type")
  costPrice         Decimal                @map("cost_price") @db.Decimal(10, 2)
  stock             Decimal                @db.Decimal(10, 2)
  enabled           Boolean                @default(true)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  arrivedAt         DateTime               @default(now()) @map("arrived_at")
  defaultCommission Decimal                @default(0.00) @map("default_commission") @db.Decimal(10, 2)
  saleCommission    Decimal                @default(0.00) @map("sale_commission") @db.Decimal(10, 2)
  salePrice         Decimal                @default(0.00) @map("sale_price") @db.Decimal(10, 2)
  items             OrderItem[]
  retailProducts    RetailProduct[]
  supermarketItems  SupermarketOrderItem[]
  supplierEntries   SupplierEntry[]

  @@index([name])
  @@map("goods")
}

model Customer {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")
  partialPayment Decimal  @default(0.00) @map("partial_payment") @db.Decimal(10, 2)
  totalDebt      Decimal  @default(0.00) @map("total_debt") @db.Decimal(10, 2)
  orders         Order[]
  paymentRecords CustomerPaymentRecord[]

  @@map("customers")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.VarChar(80)
  createdAt      DateTime        @default(now()) @map("created_at")
  partialPayment Decimal         @default(0.00) @map("partial_payment") @db.Decimal(10, 2)
  totalDebt      Decimal         @default(0.00) @map("total_debt") @db.Decimal(10, 2)
  entries        SupplierEntry[]
  paymentRecords SupplierPaymentRecord[]

  @@map("suppliers")
}

model SupermarketAccount {
  id             Int                        @id @default(autoincrement())
  name           String                     @unique @db.VarChar(80)
  createdAt      DateTime                   @default(now()) @map("created_at")
  partialPayment Decimal                    @default(0.00) @map("partial_payment") @db.Decimal(10, 2)
  totalDebt      Decimal                    @default(0.00) @map("total_debt") @db.Decimal(10, 2)
  paymentRecords SupermarketPaymentRecord[]

  @@map("supermarket_accounts")
}

model SupplierEntry {
  id              Int                    @id @default(autoincrement())
  entryNo         String                 @unique @map("entry_no") @db.VarChar(24)
  supplierId      Int                    @map("supplier_id")
  supplierName    String                 @map("supplier_name") @db.VarChar(80)
  staffId         Int                    @map("staff_id")
  staffName       String                 @map("staff_name") @db.VarChar(40)
  goodsId         Int?                   @map("goods_id")
  goodsName       String                 @map("goods_name") @db.VarChar(50)
  unitType        UnitType               @map("unit_type")
  quantity        Decimal                @db.Decimal(10, 2)
  weight          Decimal?               @db.Decimal(10, 2)
  totalAmount     Decimal                @map("total_amount") @db.Decimal(10, 2)
  partialPayment  Decimal                @default(0.00) @map("partial_payment") @db.Decimal(10, 2)
  totalCommission Decimal                @default(0.00) @map("total_commission") @db.Decimal(10, 2)
  costPrice       Decimal                @map("cost_price") @db.Decimal(10, 2)
  commission      Decimal                @default(0.00) @db.Decimal(10, 2)
  saleCommission  Decimal                @default(0.00) @map("sale_commission") @db.Decimal(10, 2)
  salePrice       Decimal                @map("sale_price") @db.Decimal(10, 2)
  stockMode       SupplierEntryStockMode @default(record_only) @map("stock_mode")
  status          SupplierEntryStatus    @default(unpaid)
  paidAt          DateTime?              @map("paid_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  supplier        Supplier               @relation(fields: [supplierId], references: [id])
  staff           StaffUser              @relation(fields: [staffId], references: [id])
  goods           Goods?                 @relation(fields: [goodsId], references: [id])
  paymentRecords  SupplierPaymentRecord[]

  @@index([createdAt])
  @@index([supplierId])
  @@index([supplierName])
  @@index([status])
  @@index([goodsId])
  @@index([staffId], map: "supplier_entries_staff_id_fkey")
  @@map("supplier_entries")
}

model Order {
  id           Int         @id @default(autoincrement())
  orderNo      String      @unique @map("order_no") @db.VarChar(24)
  customerId   Int         @map("customer_id")
  customerName String      @map("customer_name") @db.VarChar(50)
  staffId      Int         @map("staff_id")
  staffName    String      @map("staff_name") @db.VarChar(40)
  goodsAmount  Decimal     @map("goods_amount") @db.Decimal(10, 2)
  commission   Decimal     @db.Decimal(10, 2)
  totalAmount  Decimal     @map("total_amount") @db.Decimal(10, 2)
  partialPayment Decimal   @default(0.00) @map("partial_payment") @db.Decimal(10, 2)
  status       OrderStatus @default(unpaid)
  paidAt       DateTime?   @map("paid_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  profitAmount Decimal     @default(0.00) @map("profit_amount") @db.Decimal(10, 2)
  adjustmentRemark String? @map("adjustment_remark") @db.VarChar(100)
  items        OrderItem[]
  adjustments  OrderAdjustment[]
  paymentRecords CustomerPaymentRecord[]
  customer     Customer    @relation(fields: [customerId], references: [id])
  staff        StaffUser   @relation(fields: [staffId], references: [id])

  @@index([createdAt, customerId])
  @@index([status])
  @@index([customerId], map: "orders_customer_id_fkey")
  @@index([staffId], map: "orders_staff_id_fkey")
  @@map("orders")
}

model OrderAdjustment {
  id        Int                 @id @default(autoincrement())
  orderId   Int                 @map("order_id")
  name      String              @db.VarChar(30)
  type      OrderAdjustmentType
  amount    Decimal             @db.Decimal(10, 2)
  sortOrder Int                 @default(0) @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at")
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_adjustments")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  goodsId    Int      @map("goods_id")
  goodsName  String   @map("goods_name") @db.VarChar(50)
  unitType   UnitType @map("unit_type")
  quantity   Decimal  @db.Decimal(10, 2)
  price      Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  commission Decimal  @default(0.00) @db.Decimal(10, 2)
  costCommission Decimal @default(0.00) @map("cost_commission") @db.Decimal(10, 2)
  weight     Decimal? @db.Decimal(10, 2)
  costPrice  Decimal  @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  profit     Decimal  @default(0.00) @db.Decimal(10, 2)
  goods      Goods    @relation(fields: [goodsId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([goodsId])
  @@map("order_items")
}

model SupermarketOrder {
  id              Int                    @id @default(autoincrement())
  orderNo         String                 @unique @map("order_no") @db.VarChar(24)
  supermarketName String                 @map("supermarket_name") @db.VarChar(80)
  staffId         Int                    @map("staff_id")
  staffName       String                 @map("staff_name") @db.VarChar(40)
  totalAmount     Decimal                @map("total_amount") @db.Decimal(10, 2)
  partialPayment  Decimal                @default(0.00) @map("partial_payment") @db.Decimal(10, 2)
  totalCost       Decimal                @map("total_cost") @db.Decimal(10, 2)
  totalCommission Decimal                @map("total_commission") @db.Decimal(10, 2)
  totalProfit     Decimal                @map("total_profit") @db.Decimal(10, 2)
  status          SupermarketOrderStatus @default(active)
  paidAt          DateTime?              @map("paid_at")
  cancelledAt     DateTime?              @map("cancelled_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  adjustmentRemark String?               @map("adjustment_remark") @db.VarChar(100)
  items           SupermarketOrderItem[]
  adjustments     SupermarketOrderAdjustment[]
  paymentRecords  SupermarketPaymentRecord[]
  staff           StaffUser              @relation(fields: [staffId], references: [id])

  @@index([createdAt])
  @@index([supermarketName])
  @@index([status])
  @@index([staffId], map: "supermarket_orders_staff_id_fkey")
  @@map("supermarket_orders")
}

model SupermarketOrderAdjustment {
  id        Int                 @id @default(autoincrement())
  orderId   Int                 @map("order_id")
  name      String              @db.VarChar(30)
  type      OrderAdjustmentType
  amount    Decimal             @db.Decimal(10, 2)
  sortOrder Int                 @default(0) @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at")
  order     SupermarketOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("supermarket_order_adjustments")
}

model SupermarketOrderItem {
  id         Int                 @id @default(autoincrement())
  orderId    Int                 @map("order_id")
  type       SupermarketItemType
  goodsId    Int?                @map("goods_id")
  goodsName  String              @map("goods_name") @db.VarChar(50)
  unitType   UnitType            @map("unit_type")
  quantity   Decimal             @db.Decimal(10, 2)
  weight     Decimal?            @db.Decimal(10, 2)
  price      Decimal             @db.Decimal(10, 2)
  commission Decimal             @default(0.00) @db.Decimal(10, 2)
  costCommission Decimal         @default(0.00) @map("cost_commission") @db.Decimal(10, 2)
  costPrice  Decimal             @map("cost_price") @db.Decimal(10, 2)
  subtotal   Decimal             @db.Decimal(10, 2)
  costAmount Decimal             @map("cost_amount") @db.Decimal(10, 2)
  profit     Decimal             @db.Decimal(10, 2)
  goods      Goods?              @relation(fields: [goodsId], references: [id])
  order      SupermarketOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([goodsId])
  @@map("supermarket_order_items")
}

model PrintRecord {
  id           Int               @id @default(autoincrement())
  type         PrintRecordType
  status       PrintRecordStatus
  staffId      Int               @map("staff_id")
  staffName    String            @map("staff_name") @db.VarChar(40)
  orderId      Int?              @map("order_id")
  orderNo      String?           @map("order_no") @db.VarChar(24)
  customerId   Int?              @map("customer_id")
  customerName String?           @map("customer_name") @db.VarChar(50)
  printerSn    String?           @map("printer_sn") @db.VarChar(80)
  content      String            @db.Text
  response     Json?
  errorMessage String?           @map("error_message") @db.VarChar(500)
  createdAt    DateTime          @default(now()) @map("created_at")
  staff        StaffUser         @relation(fields: [staffId], references: [id])

  @@index([createdAt])
  @@index([type, status])
  @@index([staffId])
  @@index([orderId])
  @@index([orderNo])
  @@index([customerId])
  @@map("print_records")
}

model CustomerPaymentRecord {
  id             Int                   @id @default(autoincrement())
  customerId     Int                   @map("customer_id")
  customerName   String                @map("customer_name") @db.VarChar(50)
  staffId        Int                   @map("staff_id")
  staffName      String                @map("staff_name") @db.VarChar(40)
  orderId        Int?                  @map("order_id")
  orderNo        String?               @map("order_no") @db.VarChar(24)
  orderCreatedAt DateTime?             @map("order_created_at")
  action         CustomerPaymentAction
  amount         Decimal               @db.Decimal(10, 2)
  unpaidAmount   Decimal               @default(0.00) @map("unpaid_amount") @db.Decimal(10, 2)
  createdAt      DateTime              @default(now()) @map("created_at")
  customer       Customer              @relation(fields: [customerId], references: [id])
  staff          StaffUser             @relation(fields: [staffId], references: [id])
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([staffId])
  @@index([orderId])
  @@map("customer_payment_records")
}

model SupplierPaymentRecord {
  id             Int                   @id @default(autoincrement())
  supplierId     Int                   @map("supplier_id")
  supplierName   String                @map("supplier_name") @db.VarChar(80)
  staffId        Int                   @map("staff_id")
  staffName      String                @map("staff_name") @db.VarChar(40)
  entryId        Int?                  @map("entry_id")
  entryNo        String?               @map("entry_no") @db.VarChar(24)
  entryCreatedAt DateTime?             @map("entry_created_at")
  action         SupplierPaymentAction
  amount         Decimal               @db.Decimal(10, 2)
  unpaidAmount   Decimal               @default(0.00) @map("unpaid_amount") @db.Decimal(10, 2)
  createdAt      DateTime              @default(now()) @map("created_at")
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  staff          StaffUser             @relation(fields: [staffId], references: [id])
  entry          SupplierEntry?        @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([supplierId, createdAt])
  @@index([staffId])
  @@index([entryId])
  @@map("supplier_payment_records")
}

model SupermarketPaymentRecord {
  id                   Int                       @id @default(autoincrement())
  supermarketAccountId Int                       @map("supermarket_account_id")
  supermarketName      String                    @map("supermarket_name") @db.VarChar(80)
  staffId              Int                       @map("staff_id")
  staffName            String                    @map("staff_name") @db.VarChar(40)
  orderId              Int?                      @map("order_id")
  orderNo              String?                   @map("order_no") @db.VarChar(24)
  orderCreatedAt       DateTime?                 @map("order_created_at")
  action               SupermarketPaymentAction
  amount               Decimal                   @db.Decimal(10, 2)
  unpaidAmount         Decimal                   @default(0.00) @map("unpaid_amount") @db.Decimal(10, 2)
  createdAt            DateTime                  @default(now()) @map("created_at")
  supermarket          SupermarketAccount        @relation(fields: [supermarketAccountId], references: [id])
  staff                StaffUser                 @relation(fields: [staffId], references: [id])
  order                SupermarketOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([supermarketAccountId, createdAt], map: "supermarket_payment_records_account_id_created_at_idx")
  @@index([staffId], map: "supermarket_payment_records_staff_id_idx")
  @@index([orderId], map: "supermarket_payment_records_order_id_idx")
  @@map("supermarket_payment_records")
}

model RetailProduct {
  id          Int                 @id @default(autoincrement())
  name        String              @db.VarChar(80)
  category    RetailCategory
  sourceType  RetailProductSource @map("source_type")
  goodsId     Int?                @map("goods_id")
  unitType    UnitType            @map("unit_type")
  price       Decimal             @db.Decimal(10, 2)
  costPrice   Decimal             @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  costCommission Decimal          @default(0.00) @map("cost_commission") @db.Decimal(10, 2)
  commission  Decimal             @default(0.00) @db.Decimal(10, 2)
  imageUrl    String?             @map("image_url") @db.VarChar(500)
  sortOrder   Int                 @default(0) @map("sort_order")
  enabled     Boolean             @default(true)
  staffId     Int                 @map("staff_id")
  staffName   String              @map("staff_name") @db.VarChar(40)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  description String?             @db.VarChar(200)
  items       RetailOrderItem[]
  goods       Goods?              @relation(fields: [goodsId], references: [id])
  staff       StaffUser           @relation(fields: [staffId], references: [id])

  @@index([category, sortOrder])
  @@index([enabled])
  @@index([goodsId])
  @@index([staffId], map: "retail_products_staff_id_fkey")
  @@map("retail_products")
}

model RetailOrder {
  id              Int               @id @default(autoincrement())
  orderNo         String            @unique @map("order_no") @db.VarChar(24)
  customerName    String            @map("customer_name") @db.VarChar(80)
  customerPhone   String?           @map("customer_phone") @db.VarChar(40)
  remark          String?           @db.VarChar(300)
  staffId         Int               @map("staff_id")
  staffName       String            @map("staff_name") @db.VarChar(40)
  totalAmount     Decimal           @map("total_amount") @db.Decimal(10, 2)
  totalCost       Decimal           @default(0.00) @map("total_cost") @db.Decimal(10, 2)
  totalProfit     Decimal           @default(0.00) @map("total_profit") @db.Decimal(10, 2)
  totalCommission Decimal           @map("total_commission") @db.Decimal(10, 2)
  status          RetailOrderStatus @default(unpaid)
  paidAt          DateTime?         @map("paid_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  items           RetailOrderItem[]
  staff           StaffUser         @relation(fields: [staffId], references: [id])

  @@index([createdAt])
  @@index([customerName])
  @@index([status])
  @@index([staffId], map: "retail_orders_staff_id_fkey")
  @@map("retail_orders")
}

model RetailOrderItem {
  id         Int                 @id @default(autoincrement())
  orderId    Int                 @map("order_id")
  productId  Int?                @map("product_id")
  sourceType RetailProductSource @map("source_type")
  goodsId    Int?                @map("goods_id")
  goodsName  String              @map("goods_name") @db.VarChar(80)
  category   RetailCategory
  unitType   UnitType            @map("unit_type")
  quantity   Decimal             @db.Decimal(10, 2)
  weight     Decimal?            @db.Decimal(10, 2)
  price      Decimal             @db.Decimal(10, 2)
  costPrice  Decimal             @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  costAmount Decimal             @default(0.00) @map("cost_amount") @db.Decimal(10, 2)
  profit     Decimal             @default(0.00) @db.Decimal(10, 2)
  commission Decimal             @default(0.00) @db.Decimal(10, 2)
  costCommission Decimal         @default(0.00) @map("cost_commission") @db.Decimal(10, 2)
  subtotal   Decimal             @db.Decimal(10, 2)
  imageUrl   String?             @map("image_url") @db.VarChar(500)
  order      RetailOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    RetailProduct?      @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([goodsId])
  @@map("retail_order_items")
}

enum AiChatRole {
  user
  assistant
}
enum UnitType {
  weight
  qty
}

enum OrderStatus {
  unpaid
  paid
  cancelled
}

enum OrderAdjustmentType {
  add
  subtract
}

enum SupermarketOrderStatus {
  active
  paid
  cancelled
}

enum SupermarketItemType {
  own
  purchase
}

enum PrintRecordType {
  order
  customer_debt
}

enum PrintRecordStatus {
  success
  failed
}

enum CustomerPaymentAction {
  customer_partial_payment
  order_partial_payment
  order_pay_off
}

enum SupplierPaymentAction {
  supplier_partial_payment
  entry_partial_payment
  entry_pay_off
}

enum SupermarketPaymentAction {
  supermarket_partial_payment
  order_partial_payment
  order_pay_off
}

enum RetailProductSource {
  stock
  consignment
}

enum RetailCategory {
  special
  imported
  domestic
  gift
  dry
}

enum RetailOrderStatus {
  unpaid
  paid
}

enum SupplierEntryStatus {
  unpaid
  paid
}

enum SupplierEntryStockMode {
  record_only
  auto_stocked
}
